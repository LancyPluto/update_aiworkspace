SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com
SEEDANCE_API_KEY=
SEEDANCE_VIDEO_MODEL=doubao-seedance-1-5-pro-251215
SEEDANCE_VIDEO_CREATE_PATH=/api/v3/contents/generations/tasks
SEEDANCE_VIDEO_POLL_INTERVAL_SECONDS=5
SEEDANCE_VIDEO_TIMEOUT_SECONDS=900
SUNO_POLL_INTERVAL_SECONDS=30
SUNO_TIMEOUT_SECONDS=900
GENERATED_MEDIA_DIR=/data/generated-media
GENERATED_MEDIA_PUBLIC_BASE_URL=/generated

# 统一资产存储：local=本地目录（开发默认），oss=阿里云 OSS（双桶：public + private）
# 切换方式：只改下面几项 → 保存 .env → docker compose restart backend worker（无需改代码）
#   开发 local：ASSET_STORAGE_PROVIDER=local  ASSET_STORAGE_PUBLIC_BASE_URL=/generated
#   生产 oss  ：ASSET_STORAGE_PROVIDER=oss
#              ASSET_STORAGE_PUBLIC_BASE_URL=https://wlcloudai-assets-public.oss-cn-guangzhou.aliyuncs.com
#              ASSET_STORAGE_PRIVATE_BASE_URL=/api/v1/assets/private
#              OSS_PUBLIC_BUCKET=wlcloudai-assets-public
#              OSS_PRIVATE_BUCKET=wlcloudai-assets-private
#              OSS_LEGACY_BUCKET=wlcloudai-assets-prod
ASSET_STORAGE_PROVIDER=local
ASSET_STORAGE_PUBLIC_BASE_URL=/generated
# Public content-addressed media may be cached indefinitely; private URLs remain user-scoped.
ASSET_PUBLIC_CACHE_CONTROL=public,max-age=31536000,immutable
ASSET_PRIVATE_CACHE_CONTROL=private,max-age=3600
ASSET_LEGACY_CACHE_CONTROL=public,max-age=300,must-revalidate
MEDIA_VIDEO_PREVIEW_ENABLED=true
VITE_MEDIA_DELIVERY_OPTIMIZATION=true
# ASSET_STORAGE_PRIVATE_BASE_URL=/api/v1/assets/private
OSS_ENDPOINT=oss-cn-guangzhou.aliyuncs.com
OSS_BUCKET=wlcloudai-assets-prod
OSS_PUBLIC_BUCKET=wlcloudai-assets-public
OSS_PRIVATE_BUCKET=wlcloudai-assets-private
OSS_LEGACY_BUCKET=wlcloudai-assets-prod
OSS_KEY_PREFIX=
# AK 可复用 ALIYUN_CAPTCHA_ACCESS_KEY_ID / ALIYUN_CAPTCHA_ACCESS_KEY_SECRET
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# 微信 Native 扫码支付（WECHAT_NATIVE 渠道，微信支付 APIv3）
# 文档: https://pay.weixin.qq.com/doc/v3/merchant/4012791864
WECHAT_NATIVE_PAY_ENABLED=false
WECHAT_PAY_APPID=
WECHAT_PAY_MCHID=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_MERCHANT_PRIVATE_KEY_PATH=/app/WXcert/apiclient_key.pem
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=/app/WXcert/pub_key.pem
WECHAT_PAY_NOTIFY_URL=https://wlcloudai.com/api/v1/pay/wechat/native/notify
WECHAT_PAY_API_BASE_URL=https://api.mch.weixin.qq.com

# 支付宝电脑网站支付（ALIPAY_PAGE 渠道，仅支持 alipay.trade.page.pay）
# 需在开放平台为应用签约「电脑网站支付」
ALIPAY_PAGE_PAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_MERCHANT_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://wlcloudai.com/api/v1/pay/alipay/page/notify
ALIPAY_RETURN_URL=https://wlcloudai.com/billing
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do

# 生产环境 CORS（逗号分隔，勿用 *）
# CORS_ALLOWED_ORIGINS=http://wlcloudai.com,http://www.wlcloudai.com,http://8.134.93.203,https://wlcloudai.com,https://www.wlcloudai.com,https://8.134.93.203

# 留空：浏览器走当前站点 + nginx `/api` 反代；直连后端填 http://127.0.0.1:8080（勿填 /api/v1）
VITE_API_BASE_URL=
VITE_ALIYUN_CAPTCHA_ENABLED=false
VITE_ALIYUN_CAPTCHA_REGION=cn
VITE_ALIYUN_CAPTCHA_PREFIX=
VITE_ALIYUN_CAPTCHA_SCENE_ID=
VITE_DEV_PROXY_TARGET=http://backend:8080
ADMIN_NEXT_PUBLIC_API_PROXY_TARGET=http://backend:8080
# 留空则管理端通过 Next /api 代理访问后端（Docker 推荐）；直连可填 http://127.0.0.1:8080（勿带 /api 后缀）
ADMIN_NEXT_PUBLIC_API_BASE_URL=

# 容器访问外部模型网关时才设置。不要直接复用宿主机 HTTP_PROXY=127.0.0.1:xxxx；
# 如必须走本机代理，通常填 http://host.docker.internal:7897，并确保代理允许网关访问。
CONTAINER_HTTP_PROXY=
CONTAINER_HTTPS_PROXY=
CONTAINER_NO_PROXY=localhost,127.0.0.1,mysql,redis,rabbitmq,backend,agent-service,admin-frontend,user-web,nginx,host.docker.internal,wlcloudai.com,8.134.93.203,.aliyuncs.com,.aliyun.com,.cn,api.deepseek.com,.deepseek.com,ark.cn-beijing.volces.com,.volces.com,api.minimaxi.com,.minimaxi.com,api.minimax.chat,.minimax.chat

# Docker 构建：Debian apt 国内镜像（banana-slides / worker / agent-service）
APT_MIRROR=mirrors.aliyun.com
PYPI_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
