JWT_SECRET=local-dev-secret
INTERNAL_API_TOKEN=local-internal-token
AI_TASK_QUEUE=ai:task:queue
PUBLIC_BASE_URL=http://localhost:8080
PROVIDER_CALLBACK_TOKEN_TTL_HOURS=24

