ADMIN_FRONTEND_PORT=5174
USER_WEB_PORT=5173
AGENT_SERVICE_PORT=8090
APP_ENV=local
APP_PRODUCTION_MODE=false
# Phase 1 defaults to the legacy envelope. Switch to V2 only after rolling-deploy compatibility is verified.
