# 开发：ASSET_STORAGE_PROVIDER=local  ASSET_STORAGE_PUBLIC_BASE_URL=/generated
# 生产：ASSET_STORAGE_PROVIDER=oss
#   ASSET_STORAGE_PUBLIC_BASE_URL=https://wlcloudai.com/cdn  (Nginx /cdn/ 反代到公共OSS桶，经Cloudflare CDN)
#   ASSET_STORAGE_PRIVATE_BASE_URL=/api/v1/assets/private
#   OSS_PUBLIC_BUCKET=wlcloudai-assets-public
#   OSS_PRIVATE_BUCKET=wlcloudai-assets-private
#   OSS_LEGACY_BUCKET=wlcloudai-assets-prod
