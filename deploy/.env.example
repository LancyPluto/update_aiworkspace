# Docker Hub 镜像加速前缀（国内开发默认 docker.1ms.run/；直连官方 Hub 请设为空）
DOCKER_REGISTRY=docker.1ms.run/
APT_MIRROR=mirrors.aliyun.com

# 监控栈（deploy/docker-compose.monitoring.yml）
# Prometheus/Grafana 宿主机端口默认只绑定 127.0.0.1；公网 Grafana 入口走 Nginx HTTPS /grafana/
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001
GRAFANA_ROOT_URL=https://wlcloudai.com/grafana/
PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_USER=admin
# 初期验收临时密码；生产稳定后请改成强密码
GRAFANA_ADMIN_PASSWORD=123456
# 如生产网络无法拉取 gcr.io/cadvisor/cadvisor，可覆盖为服务器可拉取的 cAdvisor 镜像
CADVISOR_IMAGE=

# Grafana 登录/注册审计地图 MySQL 数据源。生产建议创建只读账号，不要让 Grafana 使用业务写账号。
GRAFANA_MYSQL_HOST=mysql:3306
GRAFANA_MYSQL_DATABASE=ai_supermarket_v1
GRAFANA_MYSQL_USER=grafana_readonly
GRAFANA_MYSQL_PASSWORD=

# 登录来源地理解析。将 GeoLite2-City.mmdb 放到仓库外的 data/geoip/ 下，compose 会只读挂载到 backend。
AUTH_GEOIP_DATABASE_PATH=/data/geoip/GeoLite2-City.mmdb
# 认证审计账号 hash 的 HMAC pepper。为空时后端会回退到 JWT_SECRET。
AUTH_SECURITY_AUDIT_HASH_PEPPER=

# 容器出站代理：生产 mihomo 7890；本地 Clash TUN/fake-ip 开发通常为 7897。
# docker-compose 注入的是 CONTAINER_HTTP_PROXY（不是 HTTP_PROXY）；生产务必设置这两项
CONTAINER_HTTP_PROXY=http://host.docker.internal:7890
CONTAINER_HTTPS_PROXY=http://host.docker.internal:7890
# 国内/可直连模型域名应放入 NO_PROXY，避免健康但节点不可用的代理影响 agent 会话
CONTAINER_NO_PROXY=localhost,127.0.0.1,mysql,redis,rabbitmq,backend,agent-service,admin-frontend,user-web,nginx,host.docker.internal,wlcloudai.com,8.134.93.203,.aliyuncs.com,.aliyun.com,.cn,api.deepseek.com,.deepseek.com,ark.cn-beijing.volces.com,.volces.com,api.minimaxi.com,.minimaxi.com,api.minimax.chat,.minimax.chat
# 宿主机/脚本用（可选）
HTTP_PROXY=http://host.docker.internal:7890
HTTPS_PROXY=http://host.docker.internal:7890
NO_PROXY=localhost,127.0.0.1,mysql,redis,rabbitmq,backend,agent-service,admin-frontend,user-web,nginx,host.docker.internal,wlcloudai.com,8.134.93.203,.aliyuncs.com,.aliyun.com,.cn,api.deepseek.com,.deepseek.com,ark.cn-beijing.volces.com,.volces.com,api.minimaxi.com,.minimaxi.com,api.minimax.chat,.minimax.chat

# 公共静态资源（优先 CDN，降低 OSS 出流量；不配则回退到 OSS 公共桶）
# user-web: VITE_PUBLIC_ASSET_BASE_URL
# admin-frontend: NEXT_PUBLIC_PUBLIC_ASSET_BASE_URL
VITE_PUBLIC_ASSET_BASE_URL=
NEXT_PUBLIC_PUBLIC_ASSET_BASE_URL=
