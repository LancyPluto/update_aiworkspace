{
  "uid": "production-container-logs-cn",
  "title": "生产容器日志",
  "description": "Alloy 采集全部 Docker 容器 stdout/stderr；默认查看最近日志，可按容器、服务、日志流、关键字和 TraceId 收敛范围。",
  "tags": ["ai-tool-market", "production", "docker", "logs", "loki"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "container", "type": "query", "label": "容器",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({container=~\".+\"}, container)",
        "definition": "label_values({container=~\".+\"}, container)",
        "includeAll": true, "allValue": ".+", "multi": true, "refresh": 2,
        "current": { "text": "All", "value": ["$__all"] }
      },
      {
        "name": "service", "type": "query", "label": "Compose 服务（可为空）",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({container=~\"${container:regex}\"}, service)",
        "definition": "label_values({container=~\"${container:regex}\"}, service)",
        "includeAll": true, "allValue": ".*", "multi": true, "refresh": 2,
        "current": { "text": "All", "value": ["$__all"] }
      },
      {
        "name": "stream", "type": "query", "label": "日志流",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({container=~\"${container:regex}\"}, stream)",
        "definition": "label_values({container=~\"${container:regex}\"}, stream)",
        "includeAll": true, "allValue": ".*", "multi": true, "refresh": 2,
        "current": { "text": "All", "value": ["$__all"] }
      },
      {
        "name": "keyword", "type": "textbox", "label": "关键字正则",
        "query": ".*", "current": { "text": ".*", "value": ".*" }
      },
      {
        "name": "traceId", "type": "textbox", "label": "TraceId / X-Request-Id（可选）",
        "query": "", "current": { "text": "", "value": "" }
      },
      {
        "name": "errorCode", "type": "textbox", "label": "ErrorCode（可选）",
        "query": "", "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "近 5 分钟活跃采集容器",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "count(sum by (container) (count_over_time({container=~\"${container:regex}\",service=~\"${service:regex}\",stream=~\"${stream:regex}\"}[5m])))", "queryType": "instant" }],
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 2, "type": "stat", "title": "近 5 分钟错误日志",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "sum(count_over_time({container=~\"${container:regex}\",service=~\"${service:regex}\",stream=~\"${stream:regex}\"} |~ \"(?i)(error|exception|failed|timeout|warn)\" [5m]))", "queryType": "instant" }],
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 20 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 3, "type": "stat", "title": "当前筛选日志速率",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "sum(rate({container=~\"${container:regex}\",service=~\"${service:regex}\",stream=~\"${stream:regex}\"} |~ ${keyword:doublequote} |= ${traceId:doublequote} |= ${errorCode:doublequote} [1m]))", "queryType": "instant" }],
      "fieldConfig": { "defaults": { "unit": "cps", "decimals": 1, "thresholds": { "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 4, "type": "timeseries", "title": "每容器日志速率",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "sum by (container) (rate({container=~\"${container:regex}\",service=~\"${service:regex}\",stream=~\"${stream:regex}\"} |~ ${keyword:doublequote} |= ${traceId:doublequote} |= ${errorCode:doublequote} [1m]))", "legendFormat": "{{container}}" }],
      "fieldConfig": { "defaults": { "unit": "cps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 18, "showPoints": "never", "stacking": { "mode": "normal", "group": "A" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 5, "type": "logs", "title": "全容器日志时间线",
      "description": "TraceId 留空时显示最近日志；填写后跨所有已选容器检索同一请求链路。",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "{container=~\"${container:regex}\",service=~\"${service:regex}\",stream=~\"${stream:regex}\"} |~ ${keyword:doublequote} |= ${traceId:doublequote} |= ${errorCode:doublequote}" }],
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true }
    },
    {
      "id": 6, "type": "logs", "title": "最近错误 / 异常 / 超时",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 26 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "{container=~\"${container:regex}\",service=~\"${service:regex}\",stream=~\"${stream:regex}\"} |~ \"(?i)(error|exception|failed|timeout|warn)\" |= ${traceId:doublequote} |= ${errorCode:doublequote}" }],
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true }
    }
  ]
}
