{
  "uid": "auth-security-geomap-cn",
  "title": "登录注册审计地球地图",
  "tags": ["ai-tool-market", "认证审计", "登录注册", "地球地图"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "eventType",
        "type": "custom",
        "label": "事件类型",
        "query": "ALL,LOGIN_PASSWORD,REGISTER_PASSWORD,LOGIN_SMS,REGISTER_SMS,SEND_SMS_CODE,RESET_PASSWORD,ADMIN_LOGIN_PASSWORD",
        "current": { "text": "ALL", "value": "ALL" },
        "includeAll": false,
        "hide": 0
      },
      {
        "name": "result",
        "type": "custom",
        "label": "结果",
        "query": "ALL,SUCCESS,FAILED",
        "current": { "text": "ALL", "value": "ALL" },
        "includeAll": false,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "geomap",
      "title": "登录/注册来源地球地图",
      "description": "数据来自 MySQL auth_security_events。只有配置 AUTH_GEOIP_DATABASE_PATH 并解析出经纬度后，地图才会出现点位。",
      "gridPos": { "h": 14, "w": 16, "x": 0, "y": 0 },
      "datasource": { "type": "mysql", "uid": "mysql-auth-audit" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT MAX(created_at) AS time, latitude, longitude, COALESCE(NULLIF(country, ''), '未知') AS country, COALESCE(NULLIF(region, ''), '未知') AS region, COALESCE(NULLIF(city, ''), '未知') AS city, event_type, result, COUNT(*) AS count FROM auth_security_events WHERE $__timeFilter(created_at) AND latitude IS NOT NULL AND longitude IS NOT NULL AND ('$eventType' = 'ALL' OR event_type = '$eventType') AND ('$result' = 'ALL' OR result = '$result') GROUP BY latitude, longitude, country, region, city, event_type, result ORDER BY count DESC LIMIT 1000"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "view": { "id": "coords", "lat": 30.0, "lon": 104.0, "zoom": 3 },
        "basemap": { "type": "default", "config": {} },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showScale": false,
          "showDebug": false
        },
        "tooltip": { "mode": "details" },
        "layers": [
          {
            "type": "markers",
            "name": "认证事件",
            "config": {
              "showLegend": true,
              "style": {
                "size": { "field": "count", "fixed": 6, "min": 4, "max": 24 },
                "color": { "field": "count", "fixed": "dark-green" },
                "opacity": 0.75,
                "symbol": { "mode": "fixed", "fixed": "img/icons/marker/circle.svg" },
                "textConfig": { "fontSize": 12, "textAlign": "center", "textBaseline": "middle", "offsetX": 0, "offsetY": 0 }
              },
              "location": { "mode": "coords", "latitude": "latitude", "longitude": "longitude" }
            }
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "认证事件趋势",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event_type, result, user_type) (increase(auth_security_events_total[5m]))",
          "legendFormat": "{{event_type}} {{result}} {{user_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 12, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "失败率(1小时)",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(auth_security_events_total{result=\"FAILED\"}[1h])) / clamp_min(sum(increase(auth_security_events_total[1h])), 1) * 100",
          "legendFormat": "失败率"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 30 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 4,
      "type": "table",
      "title": "TOP 失败 IP",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "mysql", "uid": "mysql-auth-audit" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT ip_address, COUNT(*) AS failed_count, COUNT(DISTINCT account_hash) AS account_count, MAX(created_at) AS last_seen, SUBSTRING(GROUP_CONCAT(DISTINCT failure_reason ORDER BY failure_reason SEPARATOR ', '), 1, 160) AS failure_reasons FROM auth_security_events WHERE $__timeFilter(created_at) AND result = 'FAILED' AND ip_address IS NOT NULL AND ('$eventType' = 'ALL' OR event_type = '$eventType') GROUP BY ip_address ORDER BY failed_count DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "ip_address" },
            "properties": [
              {
                "id": "links",
                "value": [
                  { "title": "跳转管理后台封禁", "url": "/admin/security/ip-blocks/new?ip=${__data.fields.ip_address}" }
                ]
              }
            ]
          }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } }
    },
    {
      "id": 5,
      "type": "table",
      "title": "TOP 城市/地区",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "mysql", "uid": "mysql-auth-audit" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT COALESCE(NULLIF(country, ''), '未知') AS country, COALESCE(NULLIF(region, ''), '未知') AS region, COALESCE(NULLIF(city, ''), '未知') AS city, COUNT(*) AS total_count, SUM(CASE WHEN result = 'FAILED' THEN 1 ELSE 0 END) AS failed_count, COUNT(DISTINCT ip_address) AS ip_count, COUNT(DISTINCT account_hash) AS account_count FROM auth_security_events WHERE $__timeFilter(created_at) AND ('$eventType' = 'ALL' OR event_type = '$eventType') AND ('$result' = 'ALL' OR result = '$result') GROUP BY country, region, city ORDER BY total_count DESC LIMIT 50"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } }, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } }
    },
    {
      "id": 6,
      "type": "table",
      "title": "管理端失败登录",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "datasource": { "type": "mysql", "uid": "mysql-auth-audit" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT created_at AS time, account_masked, ip_address, COALESCE(NULLIF(country, ''), '未知') AS country, COALESCE(NULLIF(city, ''), '未知') AS city, failure_reason, trace_id FROM auth_security_events WHERE $__timeFilter(created_at) AND event_type = 'ADMIN_LOGIN_PASSWORD' AND result = 'FAILED' ORDER BY created_at DESC LIMIT 100"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } }, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } }
    },
    {
      "id": 7,
      "type": "table",
      "title": "最近认证事件",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "datasource": { "type": "mysql", "uid": "mysql-auth-audit" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT created_at AS time, event_type, result, user_type, method, account_masked, ip_address, COALESCE(NULLIF(country, ''), '未知') AS country, COALESCE(NULLIF(city, ''), '未知') AS city, failure_reason, trace_id FROM auth_security_events WHERE $__timeFilter(created_at) AND ('$eventType' = 'ALL' OR event_type = '$eventType') AND ('$result' = 'ALL' OR result = '$result') ORDER BY created_at DESC LIMIT 200"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } }, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } }
    }
  ]
}
