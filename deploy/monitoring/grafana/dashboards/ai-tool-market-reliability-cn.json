{
  "uid": "ai-tool-market-reliability-cn",
  "title": "AI工具市场-业务可靠性总览",
  "tags": ["ai-tool-market", "业务可靠性", "生产化"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "后端指标采集状态",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "up{job=\"backend-actuator\"}", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "任务成功率",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(increase({__name__=~\"ai_task_total(_total)?\",status=\"SUCCESS\"}[1h])) / clamp_min(sum(increase({__name__=~\"ai_task_total(_total)?\"}[1h])), 1) * 100", "legendFormat": "%" }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 90 }, { "color": "green", "value": 98 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "失败供应商成本(元)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(increase({__name__=~\"ai_billing_vendor_cost_cny_total(_total)?\",outcome!=\"SUCCESS\"}[6h]))", "legendFormat": "CNY" }],
      "fieldConfig": { "defaults": { "unit": "currencyCNY", "decimals": 2, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 10 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "死信队列积压",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rabbitmq_queue_messages{queue=~\".*dead.*\"})", "legendFormat": "messages" }],
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 10 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "后端接口 QPS",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (uri, method, status) (rate(http_server_requests_seconds_count{job=\"backend-actuator\"}[5m]))", "legendFormat": "{{method}} {{uri}} {{status}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "后端接口 P95 延迟",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"backend-actuator\"}[5m])))", "legendFormat": "{{uri}}" }],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "任务结果分布",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (status, tool_code) (increase({__name__=~\"ai_task_total(_total)?\"}[15m]))", "legendFormat": "{{status}} {{tool_code}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "lineInterpolation": "linear", "fillOpacity": 35, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "执行租约领取/续租",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (result, reason) (rate({__name__=~\"ai_task_lease_claim_total(_total)?\"}[5m]))", "legendFormat": "claim {{result}} {{reason}}" },
        { "expr": "sum by (result) (rate({__name__=~\"ai_task_lease_renew_total(_total)?\"}[5m]))", "legendFormat": "renew {{result}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "失败成本归因",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (provider, failure_stage, error_code) (increase({__name__=~\"ai_billing_vendor_cost_cny_total(_total)?\",outcome!=\"SUCCESS\"}[30m]))", "legendFormat": "{{provider}} {{failure_stage}} {{error_code}}" }],
      "fieldConfig": { "defaults": { "unit": "currencyCNY", "custom": { "drawStyle": "bars", "lineInterpolation": "linear", "fillOpacity": 35, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "RabbitMQ 队列积压",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rabbitmq_queue_messages_ready", "legendFormat": "ready {{queue}}" },
        { "expr": "rabbitmq_queue_messages_unacked", "legendFormat": "unacked {{queue}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "登录成功率",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(increase({__name__=~\"auth_login_attempts_total(_total)?\",result=\"success\"}[1h])) / clamp_min(sum(increase({__name__=~\"auth_login_attempts_total(_total)?\"}[1h])), 1) * 100", "legendFormat": "%" }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 90 }, { "color": "green", "value": 98 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Agent 工具调用结果",
      "gridPos": { "h": 4, "w": 18, "x": 6, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (status, tool_code) (increase({__name__=~\"ai_agent_tool_call_total(_total)?\"}[30m]))", "legendFormat": "{{status}} {{tool_code}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "lineInterpolation": "linear", "fillOpacity": 35, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 11,
      "type": "logs",
      "title": "TraceId 日志查询入口",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 32 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{container=~\"ai-supermarket-(backend|worker|agent-service).*\"} |= \"traceId=\"", "refId": "A" }],
      "options": { "showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending" }
    }
  ]
}
