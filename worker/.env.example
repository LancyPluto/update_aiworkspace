# 后端内部 API（与仓库根目录 .env.example 中 INTERNAL_API_TOKEN 一致）
BACKEND_BASE_URL=http://127.0.0.1:8080
INTERNAL_API_TOKEN=local-internal-token

# Redis（队列名固定为 ai:task:queue，勿改）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 模型（OpenAI 兼容接口，DeepSeek 等）
MODEL_API_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=replace-with-real-key
MODEL_DEFAULT_NAME=deepseek-chat

# Worker 行为
WORKER_BLOCK_TIMEOUT_SEC=5
HTTP_TIMEOUT_SEC=120
